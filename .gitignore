# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
*.egg

# Conda
.conda/

# Models (large files)
resources/models/*
!resources/models/.gitkeep

# Environment
.env
config.user.yaml

# Node
node_modules/
frontend/node_modules/
dist/
.vite/

# Electron
out/
frontend/dist-electron/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Claude Code (personal config, not shared)
.claude/

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# User tools (except .gitkeep)
backend/tools/user_tools/*
!backend/tools/user_tools/.gitkeep
resources/models/

# GPT-SoVITS fine-tuned weights (per-user, large files)
resources/GPT-SoVITS-*/

# Test outputs
resources/test_audio/tts_output_*
resources/test_audio/*.mp3

# CodeGraph 本地索引
.codegraph/

# 记忆系统（用户数据）
data/

# 占位/验证用形象素材与解码器（scripts/fetch-placeholder-avatars.sh 下载，不入库）
frontend/public/avatar/_placeholder/
frontend/public/decoders/
# VRoid 示例 VRM 模型本体（10.7MB，脚本下载；profile 入库）
frontend/public/avatar/*/model.vrm

# 工作区内 npm 缓存（沙箱下 HOME 缓存不可写，走本地缓存）
.npm-cache/
